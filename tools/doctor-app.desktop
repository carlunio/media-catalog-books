[Desktop Entry]
Version=1.0
Type=Application
Name=Media Catalog Books - Diagnóstico
Comment=Comprueba requisitos y estado de la instalación
Terminal=true
Icon=utilities-terminal
Categories=Utility;
Exec=sh -c 'desktop_file="$1"; desktop_file="${desktop_file#file://}"; script_dir="$(CDPATH= cd -- "$(dirname -- "$desktop_file")" && pwd)"; exec "$script_dir/doctor-app.sh"' sh %k
