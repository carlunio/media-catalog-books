[Desktop Entry]
Version=1.0
Type=Application
Name=Media Catalog Books - Actualizar y arrancar
Comment=Alias compatible del lanzador principal
Terminal=true
Icon=utilities-terminal
Categories=Development;
Exec=sh -c 'desktop_file="$1"; desktop_file="${desktop_file#file://}"; script_dir="$(CDPATH= cd -- "$(dirname -- "$desktop_file")" && pwd)"; exec "$script_dir/update-and-launch-app.sh"' sh %k
