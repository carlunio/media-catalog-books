.venv/
__pycache__/
*.pyc
*.egg-info/
*.duckdb
*.bak
.env
.streamlit/
.pytest_cache/
.ruff_cache/
.runtime/
/build/
/dist/
notebooks/*

# Keep only the data folder structure in git:
# data/
#   input/
#     A/
#     B/
#     C/
#   output/
/data/*
!/data/.gitkeep
!/data/input/
!/data/output/

/data/input/*
!/data/input/.gitkeep
!/data/input/A/
!/data/input/B/
!/data/input/C/

/data/input/A/*
!/data/input/A/.gitkeep
/data/input/B/*
!/data/input/B/.gitkeep
/data/input/C/*
!/data/input/C/.gitkeep

/data/output/*
!/data/output/.gitkeep
!/data/output/covers/
!/data/output/exports/
/data/output/covers/*
!/data/output/covers/.gitkeep
/data/output/covers/A/*
!/data/output/covers/A/.gitkeep
/data/output/covers/B/*
!/data/output/covers/B/.gitkeep
/data/output/covers/C/*
!/data/output/covers/C/.gitkeep
!/data/output/covers/A/
!/data/output/covers/B/
!/data/output/covers/C/
/data/output/exports/*
!/data/output/exports/.gitkeep

/exports/

# Keep local assets out of Git. Only their preparation notes are versioned.
/assets/*
!/assets/.gitkeep
!/assets/README.md

# Generated local tooling
/.agents/
/ocr_output/

# DuckDB temporary files
*.duckdb.wal

# Additional local environments
.env.*
!.env.example

# Test, IDE and OS artifacts
.coverage
.coverage.*
/htmlcov/
.mypy_cache/
.idea/
.vscode/
*.log
.DS_Store
Thumbs.db
